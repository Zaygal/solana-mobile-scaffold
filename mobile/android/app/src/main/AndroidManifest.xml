<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Mobile Wallet Adapter talks to the wallet over a local socket, and the
         app reads the cluster over RPC, so network access is required. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 11+ package visibility. Linking.canOpenURL only answers for
         applications this app declares an interest in, so wallet detection would
         report every wallet as missing without these listed. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="phantom" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="solflare" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="backpack" />
        </intent>
    </queries>

    <application
        android:name=".MainApplication"
        android:label="MWA Scaffold"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:label="MWA Scaffold"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
